// Fails `npm run lint` when a file, export, or dependency loses its last user.
// Delete the dead code instead of adding it to an ignore list.
{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
  "ignoreBinaries": [
    // Installed in app/node_modules, which CI enters with npm --prefix app / npx.
    "electron", "electron-vite",
    "packaging/publish-skill.sh"
  ],
  "workspaces": {
    ".": {
      "entry": ["tests/**/*.{mjs,js}", "scripts/*.mjs", "packaging/*.mjs", ".github/scripts/*.mjs"],
      "project": ["tests/**/*.{mjs,js}", "scripts/**/*.mjs", "packaging/**/*.mjs"],
      // Root tests load the app's native and renderer dependencies and the DSH
      // runtime installed for packages/dsh-plugin.
      "ignoreDependencies": ["better-sqlite3", "vue", "@tanstack/vue-virtual", "@deepseek-ai/.+"]
    },
    "app": {
      "entry": ["src/main/*.ts", "src/preload/index.ts", "src/renderer/src/main.js", "tests/*.mjs", "scripts/*.mjs", "electron.vite.config.ts"],
      "project": ["src/**/*.{ts,js,mjs,vue}", "tests/**/*.mjs"],
      // @parcel/watcher is loaded by packages/adaptive-watcher, which the app
      // bundles from source; the packaged app must still ship it.
      // builder-util and @electron/asar come with electron-builder.
      "ignoreDependencies": ["@parcel/watcher", "builder-util", "@electron/asar"]
    },
    "packages/cli": { "entry": ["src/obelisk.ts", "scripts/*.mjs"], "project": ["src/**/*.ts"] },
    "packages/core": { "project": ["src/**/*.ts"] },
    "packages/dsh-plugin": {
      "entry": ["src/index.ts", "src/context-window.ts", "scripts/*.mjs"],
      "project": ["src/**/*.ts"],
      // Exercised by the root DSH plugin tests, not by the plugin source.
      "ignoreDependencies": ["@deepseek-ai/.+"]
    },
    "packages/adaptive-watcher": { "project": ["src/**/*.ts"] }
  }
}
