{
  "name": "@obelisk/dsh-obelisk-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Optional DeepSeek Harness provider for its plugin-owned Obelisk agent skill.",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": "./dist/index.js",
    "./context-window": "./dist/context-window.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "obelisk.cordis.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./obelisk.cordis.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "smoke:install": "node scripts/install-smoke.mjs",
