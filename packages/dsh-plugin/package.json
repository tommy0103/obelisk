    "@deepseek-ai/dsh-llm": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-session-projection": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-skill": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-token-meter": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-code-runtime": { "optional": true },
    "@deepseek-ai/dsh-compaction": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-session-persistence": { "optional": true },
    "@deepseek-ai/dsh-session-projection": { "optional": true },
